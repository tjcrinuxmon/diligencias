# ====================================
# Sistema de Diligencias - Configuración
# ====================================
# Copia este archivo como .env y configura los valores

# Puerto del servidor
PORT=3000

# Clave secreta para sesiones (cambia esto en producción)
SESSION_SECRET=cambia-esta-clave-secreta-en-produccion

# Configuración SMTP para envío de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tudominio.gob.mx
SMTP_PASS=tu_contrasena_de_aplicacion

# Para Gmail: usa una "Contraseña de aplicación" 
# (Cuenta Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicación)
